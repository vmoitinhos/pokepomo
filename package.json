{
  "name": "pokepomo",
  "productName": "PokePomo",
  "version": "1.0.0",
  "description": "A Pokemon-themed Pomodoro timer for the desktop. FireRed/LeafGreen GBA sprites, XP, levels, evolutions and egg luck.",
  "main": "electron/main.js",
  "author": "vmoitinhos",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:mac:dir": "electron-builder --mac --dir",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.vmoitinhos.pokepomo",
    "productName": "PokePomo",
    "files": [
      "electron/**/*",
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "dmg": {
      "title": "PokePomo",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  }
}
